# Install: cp scripts/bbb-embedder-health.{service,timer} ~/.config/systemd/user/ &&
#   install -m 755 scripts/bbb-embedder-health.sh ~/bin/ && systemctl --user daemon-reload &&
#   systemctl --user enable --now bbb-embedder-health.timer
# Requires ~/bin/lib/intent-runtime.sh and ~/bin/lib/alert-floor.sh (intent-os, deployed by its
#   alert-floor install); without them the script still logs but cannot page.
[Unit]
Description=Bob's Big Brain — embedder health check; pages Buzz sys-automation if dense retrieval is down (beads 39z.15, 39z.25)

[Service]
Type=oneshot
ExecStart=%h/bin/bbb-embedder-health.sh
Nice=10
